# 统一换行与二进制识别，避免跨平台 diff 噪音
* text=auto

# Windows 脚本保留 CRLF，其余源码统一 LF
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.sh     text eol=lf
*.py     text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf

# 二进制：不参与 diff、不做换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.pptx   binary
*.zip    binary
*.7z     binary

# 生成物不参与 diff 统计
package-lock.json linguist-generated=true
pnpm-lock.yaml    linguist-generated=true
