# 密钥与本地配置，永不入库
.env
.env.*
!.env.example
.ssh/

# 子项目各自是独立仓库，父仓库不跟踪；模板本身要保留
projects/*
!projects/_template/

# 数据与素材（可能含客户隐私/大文件），不入库
data/

# 便携工具与缓存：目录内容不入库，但脚手架脚本要入
tools/*
!tools/new-project.ps1
.venv/
node_modules/
.npm-cache/
__pycache__/
*.pyc

# 临时产物
tmp/
*.log
*.tmp
~$*

# 权限修复的审计与回滚档案（本机专用，不入库）
notes/acl-reports/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
